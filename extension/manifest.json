{
  "manifest_version": 3,
  "name": "Chat Archiver",
  "version": "1.2.0",
  "description": "ChatGPT・Claude・Grok の会話履歴を Markdown にして GitHub リポジトリへ自動コミットします。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "scripting",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://grok.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Chat Archiver の設定"
  },
  "options_page": "options.html"
}
